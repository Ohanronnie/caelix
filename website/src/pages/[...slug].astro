---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { flattenNavigation, getNavigation, getPageTitle } from "../lib/docs";

export async function getStaticPaths() {
  const entries = (await getCollection("docs")).filter(
    (entry) => entry.id.toLowerCase() !== "summary",
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"docs"> };
const { Content, headings } = await render(entry);
const navigation = getNavigation();
const pages = flattenNavigation(navigation);
const index = pages.findIndex((page) => page.id === entry.id);
const title = getPageTitle(entry);
---

<DocsLayout
  title={title}
  id={entry.id}
  headings={headings}
  navigation={navigation}
  previous={pages[index - 1]}
  next={pages[index + 1]}
>
  <Content />
</DocsLayout>
