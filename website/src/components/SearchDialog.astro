---
import { getBaseUrl } from "../lib/docs";
---

<dialog
  class="search-dialog"
  data-search-dialog
  data-pagefind-url={getBaseUrl("pagefind/pagefind.js")}
  aria-label="Search Caelix documentation"
>
  <form class="search-form" method="dialog" data-search-form>
    <span aria-hidden="true">⌕</span>
    <input
      data-search-input
      type="search"
      autocomplete="off"
      placeholder="Search the documentation"
      aria-label="Search documentation"
    />
    <button type="submit" class="icon-button" aria-label="Close search"
      >×</button
    >
  </form>
  <div class="search-results" data-search-results role="listbox"></div>
</dialog>

<script is:inline>
  const dialog = document.querySelector("[data-search-dialog]");
  const input = document.querySelector("[data-search-input]");
  const resultsContainer = document.querySelector("[data-search-results]");
  const triggers = document.querySelectorAll("[data-open-search]");
  const pagefindUrl = dialog?.dataset.pagefindUrl;
  let pagefind;
  let activeResult = -1;

  const renderStatus = (message) => {
    if (resultsContainer)
      resultsContainer.innerHTML = `<p class="search-status">${message}</p>`;
  };

  const open = async () => {
    if (!dialog?.open) dialog?.showModal();
    input?.focus();
    if (!pagefind) {
      renderStatus("Loading search…");
      try {
        pagefind = await import(pagefindUrl);
        renderStatus("Start typing to search.");
      } catch {
        renderStatus("Search is unavailable in this preview.");
      }
    }
  };

  triggers.forEach((trigger) => trigger.addEventListener("click", open));
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      open();
    }
  });

  input?.addEventListener("input", async () => {
    const query = input.value.trim();
    activeResult = -1;
    if (!query) return renderStatus("Start typing to search.");
    if (!pagefind) return;
    renderStatus("Searching…");
    const search = await pagefind.search(query);
    if (!search.results.length) return renderStatus("No matching pages.");
    const results = await Promise.all(
      search.results.slice(0, 12).map((result) => result.data()),
    );
    if (!resultsContainer) return;
    resultsContainer.innerHTML = "";
    results.forEach((result) => {
      const link = document.createElement("a");
      link.className = "search-result";
      link.href = result.url;
      link.role = "option";
      link.innerHTML = `<strong>${result.meta.title || "Caelix documentation"}</strong><span>${result.excerpt}</span>`;
      resultsContainer.append(link);
    });
  });

  input?.addEventListener("keydown", (event) => {
    const links = Array.from(
      resultsContainer?.querySelectorAll(".search-result") ?? [],
    );
    if (!links.length) return;
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      activeResult =
        event.key === "ArrowDown"
          ? Math.min(activeResult + 1, links.length - 1)
          : Math.max(activeResult - 1, 0);
      links.forEach((link, index) =>
        link.setAttribute("aria-selected", String(index === activeResult)),
      );
      links[activeResult].scrollIntoView({ block: "nearest" });
    }
    if (event.key === "Enter" && activeResult >= 0) links[activeResult].click();
  });
</script>
