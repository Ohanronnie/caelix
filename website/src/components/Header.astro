---
import { getBaseUrl, getDocsUrl } from "../lib/docs";

const pathname = Astro.url.pathname;
const isDocs =
  pathname.includes("/getting-started/") ||
  pathname.includes("/concepts/") ||
  pathname.includes("/advanced/") ||
  pathname.includes("/recipes/") ||
  pathname.includes("/reference/") ||
  pathname.includes("/cli/") ||
  pathname.includes("/why-caelix/") ||
  pathname.includes("/introduction/");
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={getBaseUrl()} aria-label="Caelix home">
      <span class="brand-mark">C</span>
      <span>caelix</span>
    </a>
    <nav class="top-nav" aria-label="Primary navigation">
      <a
        href={getDocsUrl("getting-started/overview")}
        aria-current={pathname.includes("getting-started") ? "page" : undefined}
        >Docs</a
      >
      <a
        href={getDocsUrl("concepts/modules")}
        aria-current={pathname.includes("concepts") ? "page" : undefined}
        >Concepts</a
      >
      <a
        href={getDocsUrl("recipes/common-tasks")}
        aria-current={pathname.includes("recipes") ? "page" : undefined}
        >Recipes</a
      >
      <a href="https://github.com/Ohanronnie/caelix">GitHub</a>
    </nav>
    <div class="header-actions">
      <button
        class="search-trigger"
        type="button"
        data-open-search
        aria-label="Search documentation"
      >
        <span aria-hidden="true">⌕</span><span class="search-label">Search</span
        ><kbd class="key-hint">⌘K</kbd>
      </button>
      <button
        class="icon-button"
        type="button"
        data-theme-toggle
        aria-label="Use dark theme"
        title="Toggle color theme">◐</button
      >
      {
        isDocs && (
          <button
            class="menu-button"
            type="button"
            data-sidebar-toggle
            aria-controls="docs-sidebar"
            aria-expanded="false"
            aria-label="Open documentation navigation"
          >
            ☰
          </button>
        )
      }
    </div>
  </div>
</header>

<script>
  const themeButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const setTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("caelix-theme", theme);
    themeButtons.forEach((themeButton) => {
      themeButton.setAttribute(
        "aria-label",
        `Use ${theme === "dark" ? "light" : "dark"} theme`,
      );
    });
  };

  themeButtons.forEach((themeButton) => {
    themeButton.addEventListener("click", () => {
      setTheme(
        document.documentElement.dataset.theme === "dark" ? "light" : "dark",
      );
    });
  });

  const menu = document.querySelector<HTMLButtonElement>(
    "[data-sidebar-toggle]",
  );
  const sidebar = document.querySelector<HTMLElement>("[data-docs-sidebar]");
  menu?.addEventListener("click", () => {
    const open = sidebar?.dataset.open !== "true";
    if (sidebar) sidebar.dataset.open = String(open);
    menu.setAttribute("aria-expanded", String(open));
    menu.setAttribute(
      "aria-label",
      open ? "Close documentation navigation" : "Open documentation navigation",
    );
  });
</script>
