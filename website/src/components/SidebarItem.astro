---
import type { NavigationItem } from "../lib/docs";
import { getDocsUrl } from "../lib/docs";
import SidebarItem from "./SidebarItem.astro";

interface Props {
  item: NavigationItem;
  currentId: string;
}

const { item, currentId } = Astro.props;
---

<li>
  <a
    href={getDocsUrl(item.id)}
    aria-current={item.id === currentId ? "page" : undefined}>{item.title}</a
  >
  {
    item.children.length > 0 && (
      <ul>
        {item.children.map((child) => (
          <SidebarItem item={child} currentId={currentId} />
        ))}
      </ul>
    )
  }
</li>
